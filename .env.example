# ─────────────────────────────────────────────
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Postgres
POSTGRES_DB=ccp
POSTGRES_USER=ccp
POSTGRES_PASSWORD=change_me_strong_password

# Backend
SESSION_SECRET=change_me_32_char_random_string
ADMIN_EMAIL=your@email.com

# Port exposed on your homelab host
HOST_PORT=8080

# Cookie security:
# keep false if accessing directly via plain HTTP (e.g. http://192.168.x.x:8080)
# set to true if accessing through HTTPS / reverse proxy with SSL (e.g. Cloudflare, Caddy)
COOKIE_SECURE=false
